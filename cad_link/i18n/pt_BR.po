#: code:addons/cad_link/static/src/cad_documents.xml:0
msgid "CAD documents"
msgstr "Documentos CAD"

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.xml:0
msgid "Save the product before opening its CAD documents."
msgstr "Salve o produto antes de abrir seus documentos CAD."

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.xml:0
msgid "Open item folder"
msgstr "Abrir pasta do item"

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.xml:0
msgid "Refresh"
msgstr "Atualizar"

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.xml:0
msgid "Loading CAD documents…"
msgstr "Carregando documentos CAD…"

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.xml:0
msgid "Choose a product variant to see the files for its internal reference."
msgstr "Escolha uma variante do produto para ver os arquivos de seu código."

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.xml:0
msgid "Select variant"
msgstr "Selecionar variante"

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.xml:0
msgid "CAD folder"
msgstr "Pasta CAD"

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.xml:0
msgid "Copy path"
msgstr "Copiar caminho"

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.xml:0
msgid "Network actions open the original files with CAD-link Desktop. Your Windows access permissions apply."
msgstr "As ações na rede abrem os arquivos originais com o CAD-link Desktop. Valem suas permissões de acesso no Windows."

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.xml:0
msgid "Copy the path to open it in Explorer. Direct network actions require CAD-link Desktop to be enabled."
msgstr "Copie o caminho para abri-lo no Explorer. As ações diretas na rede precisam do CAD-link Desktop habilitado."

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.xml:0
msgid "No documents available for your access group in this item folder."
msgstr "Não há documentos disponíveis para seu grupo de acesso na pasta deste item."

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.xml:0
msgid "File"
msgstr "Arquivo"

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.xml:0
msgid "Size"
msgstr "Tamanho"

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.xml:0
msgid "Actions"
msgstr "Ações"

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.xml:0
msgid "Open on network"
msgstr "Abrir na rede"

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.xml:0
msgid "View PDF"
msgstr "Visualizar PDF"

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.xml:0
msgid "Show in folder"
msgstr "Mostrar na pasta"

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.xml:0
msgid "Download"
msgstr "Baixar"

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.js:0
msgid "CAD documents could not be loaded."
msgstr "Não foi possível carregar os documentos CAD."

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.js:0
msgid "Folder path copied."
msgstr "Caminho da pasta copiado."

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.js:0
msgid "Select and copy the folder path shown above."
msgstr "Selecione e copie o caminho da pasta exibido acima."

#. module: cad_link
#: model:ir.model.fields,field_description:cad_link.field_res_company__cad_desktop_enabled
msgid "Enable CAD-link Desktop"
msgstr "Habilitar CAD-link Desktop"

#. module: cad_link
#: code:addons/cad_link/models/product.py:0
msgid "Access to CAD storage was denied."
msgstr "O acesso ao armazenamento CAD foi negado."

#. module: cad_link
#: code:addons/cad_link/models/product.py:0
msgid "The item folder does not exist."
msgstr "A pasta do item não existe."

#. module: cad_link
#: code:addons/cad_link/models/product.py:0
msgid "CAD storage is temporarily unavailable."
msgstr "O armazenamento CAD está temporariamente indisponível."

#. module: cad_link
#: code:addons/cad_link/models/res_company.py:0
msgid "Configure a Windows share before enabling CAD-link Desktop."
msgstr "Configure um compartilhamento Windows antes de habilitar o CAD-link Desktop."

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.xml:0
msgid "View 3D"
msgstr "Visualizar 3D"

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.xml:0
msgid "Close 3D"
msgstr "Fechar 3D"

#. module: cad_link
#. odoo-javascript
#: code:addons/cad_link/static/src/cad_documents.xml:0
msgid "3D preview"
msgstr "Visualização 3D"

#. module: cad_link
#: model_terms:ir.ui.view,arch_db:cad_link.viewer
msgid "Reset view"
msgstr "Restaurar vista"

#. module: cad_link
#: model_terms:ir.ui.view,arch_db:cad_link.viewer
msgid "Full screen"
msgstr "Tela cheia"

#. module: cad_link
#: model_terms:ir.ui.view,arch_db:cad_link.viewer
msgid "Exit full screen"
msgstr "Sair da tela cheia"

#. module: cad_link
#: model_terms:ir.ui.view,arch_db:cad_link.viewer
msgid "Loading 3D preview…"
msgstr "Carregando visualização 3D…"

#. module: cad_link
#: model_terms:ir.ui.view,arch_db:cad_link.viewer
msgid "Drag to rotate. Scroll or pinch to zoom."
msgstr "Arraste para girar. Use a roda do mouse ou o gesto de pinça para aproximar."

#. module: cad_link
#: model_terms:ir.ui.view,arch_db:cad_link.viewer
msgid "The 3D preview could not be loaded. Check access and export a self-contained GLB 2.0 with embedded PNG/JPEG textures, without compression."
msgstr "Não foi possível carregar o 3D. Verifique o acesso e exporte um GLB 2.0 com os recursos e as texturas PNG/JPEG no próprio arquivo, sem compressão."

#. module: cad_link
#: model_terms:ir.ui.view,arch_db:cad_link.viewer
msgid "Full screen is unavailable in this browser."
msgstr "A tela cheia não está disponível neste navegador."

#. module: cad_link
#: model_terms:ir.ui.view,arch_db:cad_link.viewer
msgid "Exported visualization. Use the original CAD document for engineering work."
msgstr "Visualização exportada. Use o documento CAD original para o trabalho de engenharia."

#. module: cad_link
#: code:addons/cad_link/models/product.py:0
msgid "CAD source access is required for 3D previews."
msgstr "É necessário acesso aos arquivos CAD para visualizar o 3D."

#. module: cad_link
#: code:addons/cad_link/models/product.py:0
msgid "3D preview requires a GLB file."
msgstr "A visualização 3D exige um arquivo GLB."

#. module: cad_link
#: code:addons/cad_link/models/product.py:0
msgid "This GLB cannot be previewed. Export a self-contained GLB 2.0 with embedded PNG/JPEG textures and without compression."
msgstr "Este GLB não pode ser visualizado. Exporte um GLB 2.0 com as texturas PNG/JPEG incluídas no próprio arquivo e sem compressão."
