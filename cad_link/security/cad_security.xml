<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_cad" model="ir.module.category">
        <field name="name">CAD-link</field>
        <field name="sequence">35</field>
    </record>
    <record id="group_cad_documents" model="res.groups">
        <field name="name">PDF documents</field>
        <field name="category_id" ref="module_category_cad"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_cad_sources" model="res.groups">
        <field name="name">PDF and CAD sources</field>
        <field name="category_id" ref="module_category_cad"/>
        <field name="implied_ids" eval="[(4, ref('group_cad_documents'))]"/>
    </record>
</odoo>
