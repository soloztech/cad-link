<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="cad_link.CadDocuments" owl="1">
        <section class="o_cad_documents w-100" aria-label="CAD documents">
            <div t-if="needsSave" class="alert alert-info" role="status">
                Save the product before opening its CAD documents.
            </div>
            <t t-else="">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <a t-if="state.data and state.data.folder_url" t-att-href="state.data.folder_url" class="btn btn-primary">
                        <i class="fa fa-folder-open me-1" aria-hidden="true"/>Open item folder
                    </a>
                    <button type="button" class="btn btn-secondary" t-on-click="load" t-att-disabled="state.loading">
                        <i class="fa fa-refresh me-1" aria-hidden="true"/>Refresh
                    </button>
                </div>
                <p t-if="state.loading" role="status">Loading CAD documents…</p>
                <div t-if="state.error" class="alert alert-warning" role="alert" t-esc="state.error"/>
                <t t-if="state.data">
                    <t t-if="state.data.select_variant">
                        <p>Choose a product variant to see the files for its internal reference.</p>
                        <button type="button" class="btn btn-primary" t-on-click="selectVariant">Select variant</button>
                    </t>
                    <t t-else="">
                        <div t-if="state.data.folder_path" class="input-group mb-2">
                            <input type="text" class="form-control" readonly="readonly" aria-label="CAD folder" t-att-value="state.data.folder_path"/>
                            <button type="button" class="btn btn-secondary" t-on-click="copyFolder">Copy path</button>
                        </div>
                        <p t-if="state.data.desktop_enabled" class="text-muted small">
                            Network actions open the original files with CAD-link Desktop. Your Windows access permissions apply.
                        </p>
                        <p t-elif="state.data.folder_path" class="text-muted small">
                            Copy the path to open it in Explorer. Direct network actions require CAD-link Desktop to be enabled.
                        </p>
                        <p t-if="!state.data.documents.length" role="status">No documents available for your access group in this item folder.</p>
                        <div t-else="" class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead><tr><th>File</th><th>Size</th><th>Actions</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="state.data.documents" t-as="doc" t-key="doc.name">
                                        <td class="text-break" t-esc="doc.name"/>
                                        <td class="text-nowrap" t-esc="formatSize(doc.size)"/>
                                        <td>
                                            <div class="d-flex flex-wrap gap-2">
                                                <button t-if="doc.viewer_url" type="button" class="btn btn-primary btn-sm" t-on-click="() => this.view3D(doc)">View 3D</button>
                                                <a t-if="doc.open_url" t-att-href="doc.open_url" class="btn btn-primary btn-sm">Open on network</a>
                                                <a t-if="doc.kind === 'pdf'" t-att-href="doc.url" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm">View PDF</a>
                                                <a t-if="doc.folder_url" t-att-href="doc.folder_url" class="btn btn-outline-secondary btn-sm">Show in folder</a>
                                                <a t-att-href="doc.download_url" class="btn btn-outline-secondary btn-sm">Download</a>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div t-if="state.preview" class="mt-3 border rounded">
                            <div class="d-flex align-items-center justify-content-between p-2 border-bottom">
                                <strong>3D preview</strong>
                                <button type="button" class="btn btn-outline-secondary btn-sm" t-on-click="close3D">Close 3D</button>
                            </div>
                            <iframe t-key="state.preview.url" t-att-src="state.preview.url" t-att-title="state.preview.name"
                                    class="w-100 border-0" style="height: 520px; display: block;" sandbox="allow-scripts allow-same-origin"
                                    allow="fullscreen" allowfullscreen="allowfullscreen" referrerpolicy="no-referrer"/>
                        </div>
                    </t>
                </t>
            </t>
        </section>
    </t>
</templates>
