<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_form_cad" model="ir.ui.view">
        <field name="name">product.product.form.cad.link</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="CAD" groups="cad_link.group_cad_documents">
                    <widget name="cad_documents"/>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_template_form_cad" model="ir.ui.view">
        <field name="name">product.template.form.cad.link</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="CAD" groups="cad_link.group_cad_documents">
                    <widget name="cad_documents"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
